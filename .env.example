APP_NAME=Pramaan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Windows / XAMPP: use MySQL. (Sandbox/Linux: sqlite) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pramaan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@pramaan.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Payment ---
# mock = local development (no credentials). razorpay = real/test gateway.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=

# --- Blockchain ---
# mock = local deterministic simulation. arbitrum = real Arbitrum Sepolia RPC.
BLOCKCHAIN_PROVIDER=mock
ARBITRUM_RPC_URL=
ARBITRUM_CHAIN_ID=421614
ARBITRUM_CONTRACT_ADDRESS=
ARBITRUM_WALLET_ADDRESS=
ARBITRUM_PRIVATE_KEY=
ARBITRUM_GAS_LIMIT=300000
ARBITRUM_CONFIRMATION_BLOCKS=2

# --- AI ---
# openai = real Laravel AI SDK (set OPENAI_API_KEY). No key -> safe local fallback.
AI_PROVIDER=openai
OPENAI_API_KEY=

# --- Pricing ---
PRICING_CURRENCY=INR
PRICING_PRICE_PER_CERTIFICATE=50
PRICING_TAX_RATE=18
